# Описание атрибутов вершины для шейдера по умолчанию.
#
#                   координаты      цвет        uv
# Пример вершины: [ 1,0,0,          1,1,1,1,    1,0]
# Для такой вершины список атрибутов будет следующий - 3,float,pos; 4,float,col; 2,float,uv;
#
# Порядок в котором перечисляются атрибуты на прямую влияет на то, в какие индексы
# будут помещены атрибуты. Так координаты в атрибуте из примера будут помещены в индекс 0,
# цвет в индекс 1, uv в индекс 3.
#
# Формат атрибутов "<количество элементов атрибута>, <тип данных атрибута>, <вид атрибута>;"
#
# Допустимые типы данных атрибутов:
#   - 0x1406 // GL_FLOAT
#   - ...
#
# Допустимые виды атрибутов:
#   - 0 // POSITION_TYPE
#   - 1 // COLOR_TYPE
#   - 2 // UV_TYPE
#
# Далее следует перечисление атрибутов шейдера по умолчанию:

# [0] position
3, 0x1406, 0;

# [1] color
4, 0x1406, 1;

# [2] uv
2, 0x1406, 2;




